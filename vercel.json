{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/catalogue-request.js": {
      "includeFiles": "private/catalogues/QL_Tea_Life_Wholesale_Tea_Catalogue_Web.pdf"
    }
  },
  "redirects": [
    {
      "source": "/tea-knowledge/private-label-tea-guide",
      "destination": "https://www.qltealife.com/tea-knowledge/private-label-tea-how-to-build-your-own-tea-brand",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "qltealife.com"
        }
      ],
      "destination": "https://www.qltealife.com/:path*",
      "permanent": true
    }
  ]
}
