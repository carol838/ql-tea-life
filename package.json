{
  "name": "ql-tea-life",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.ai-os.json --noEmit",
    "build:ai-os": "tsc -p tsconfig.ai-os.json",
    "qualify:inquiry": "npm run build:ai-os && node .ai-os-build/scripts/qualify-inquiry.js",
    "test": "npm run build:ai-os && node .ai-os-build/scripts/test-qualification-workflow.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.0"
  }
}
